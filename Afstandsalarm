import time
from machine import Pin, time_pulse_us

redLed = Pin(7, Pin.OUT)
greenLed = Pin(6, Pin.OUT)

trig = Pin(12, Pin.OUT)
echo = Pin(13, Pin.IN)

def maalAfstand():
        trig.value(0)
        time.sleep_us(2)
        trig.value(1)
        time.sleep_us(10)
        trig.value(0)
        varighed = time_pulse_us(echo, 1, 30000)
        afstand = varighed / 58
        return afstand

while True:
    
    afstand = maalAfstand()
    if afstand < 20:
        redLed.value(1)
        greenLed.value(0)
        print("Stop!")
    else:
        greenLed.value(1)
        redLed.value(0)
        print("Fri bane")
    time.sleep_ms(200)
